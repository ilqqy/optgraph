{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ilqqy/optgraph/schema/graph.schema.json",
  "title": "optgraph graph.json",
  "description": "Module import graph and option definitions of one NixOS configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "modules", "options"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "options": {
      "type": "array",
      "items": { "$ref": "#/$defs/option" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "nixpkgsRev",
        "nixpkgsVersion",
        "generatedAt",
        "toolVersion",
        "scope",
        "attribution",
        "complete",
        "warnings"
      ],
      "properties": {
        "host": { "$ref": "#/$defs/nullableString" },
        "nixpkgsRev": { "$ref": "#/$defs/nullableString" },
        "nixpkgsVersion": { "type": "string" },
        "generatedAt": { "$ref": "#/$defs/nullableString" },
        "toolVersion": { "type": "string" },
        "scope": { "enum": ["user", "all"] },
        "attribution": { "enum": ["aligned", "file-based"] },
        "complete": { "type": "boolean" },
        "submoduleDepth": {
          "description": "--submodule-depth: definitions inside submodule instances are attributed down to this many instance levels. Absent when nesting is disabled (depth 0) or the producer predates it.",
          "type": "integer",
          "minimum": 1
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "subject"],
      "properties": {
        "code": {
          "enum": [
            "alignment-failed",
            "nixpkgs-untested",
            "input-ambiguous",
            "module-error",
            "graph-mismatch",
            "eval-crash",
            "preview-crash",
            "selfcheck-crash",
            "selfcheck-skipped",
            "reconstruction-mismatch",
            "budget-exhausted",
            "nested-degraded",
            "nested-crash",
            "nested-unchecked"
          ]
        },
        "message": { "type": "string" },
        "subject": { "$ref": "#/$defs/nullableString" }
      }
    },
    "origin": {
      "type": "string",
      "pattern": "^(user|user-inline|nixpkgs|unknown|input:.+)$"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "imports", "origin", "disabled", "modulesIndex", "position"],
      "properties": {
        "id": { "type": "string" },
        "file": { "type": "string" },
        "imports": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "origin": { "$ref": "#/$defs/origin" },
        "disabled": { "type": "boolean" },
        "modulesIndex": { "type": ["integer", "null"], "minimum": 0 },
        "position": { "$ref": "#/$defs/nullableString" },
        "scope": {
          "description": "Path of the submodule instance this module belongs to (e.g. users.users.alice); absent for top-level modules. Nested module ids are «<scope>»<key>.",
          "type": "string"
        },
        "owner": {
          "description": "Only on an instance's definition modules: id of the module whose definition became this module (top-level or nested).",
          "type": "string"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "loc",
        "declaredIn",
        "type",
        "definitions",
        "winners",
        "highestPrio",
        "omitted",
        "error"
      ],
      "properties": {
        "path": { "type": "string" },
        "instance": {
          "description": "Nested options only: path of the submodule instance the option belongs to.",
          "type": "string"
        },
        "parent": {
          "description": "Nested options only: path of the option whose value holds the instance (equals instance for a single submodule).",
          "type": "string"
        },
        "loc": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "declaredIn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "type": { "$ref": "#/$defs/nullableString" },
        "definitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/definition" }
        },
        "winners": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "highestPrio": { "type": ["integer", "null"] },
        "omitted": {
          "description": "nixpkgs definitions from nixpkgs modules that are not the only winner, counted instead of listed (zero with --include-all-definitions); never the option default, which is always listed",
          "type": "object",
          "additionalProperties": false,
          "required": ["nixpkgsActive", "nixpkgsInactive", "nixpkgsWinners"],
          "properties": {
            "nixpkgsActive": { "type": "integer", "minimum": 0 },
            "nixpkgsInactive": { "type": "integer", "minimum": 0 },
            "nixpkgsWinners": {
              "description": "How many of the nixpkgsActive ones win (active at highestPrio); <= nixpkgsActive, not counted a second time. Always 0 when the option has a single winner (it is listed). When winners is empty and this is > 0, every winner is an omitted nixpkgs definition.",
              "type": "integer",
              "minimum": 0
            },
            "declarationActive": {
              "description": "Nested options only, absent when 0: active definitions of the submodule's own non-nixpkgs declaration modules (e.g. home-manager's), counted instead of listed.",
              "type": "integer",
              "minimum": 0
            },
            "declarationInactive": {
              "description": "Nested options only, absent when 0: inactive definitions of the submodule's own non-nixpkgs declaration modules, counted instead of listed.",
              "type": "integer",
              "minimum": 0
            },
            "declarationWinners": {
              "description": "Nested options only, absent when 0: how many of declarationActive win (active at highestPrio); <= declarationActive, not counted a second time. When winners is empty and this is > 0, the winners are omitted declaration definitions (with nixpkgsWinners, if any).",
              "type": "integer",
              "minimum": 0
            },
            "declarationOrigin": {
              "description": "Nested options only: the origin shared by every counted declaration definition (e.g. input:home-manager); absent when none are counted or their origins differ.",
              "$ref": "#/$defs/origin"
            }
          }
        },
        "error": { "$ref": "#/$defs/nullableString" }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "module", "priority", "active", "condition", "valuePreview"],
      "properties": {
        "kind": { "enum": ["definition", "default"] },
        "file": {
          "description": "Absent when it equals the file of `module` (resolve it via modules[]).",
          "$ref": "#/$defs/nullableString"
        },
        "module": { "$ref": "#/$defs/nullableString" },
        "priority": { "type": ["integer", "null"] },
        "active": { "type": "boolean" },
        "condition": { "enum": ["mkIf-false", "mkIf-error", null] },
        "valuePreview": { "$ref": "#/$defs/nullableString" },
        "shadowedAt": {
          "description": "Nested options only: the definition never reached the instance because its enclosing definition lost on priority at this option or instance path. Never a winner.",
          "type": "string"
        }
      }
    }
  }
}
